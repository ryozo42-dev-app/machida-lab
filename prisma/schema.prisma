generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model customer_insurance_prices {
  id                Int       @id @default(autoincrement())
  customer_id       Int
  insurance_item_id Int
  price             Decimal   @db.Decimal(10, 2)
  created_at        DateTime? @default(now()) @db.Timestamp(6)
}

model customer_private_prices {
  id              Int       @id @default(autoincrement())
  customer_id     Int
  private_item_id Int
  price           Decimal   @db.Decimal(10, 2)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
}

model customers {
  id                         Int                          @id @default(autoincrement())
  code                       String                       @unique @db.VarChar(20)
  name                       String                       @db.VarChar(100)
  created_at                 DateTime?                    @default(now()) @db.Timestamp(6)
  billing_closing_day        Int?
  billing_closing_month_end  Boolean                      @default(false)
  billing_issue_day          Int?
  show_material_on_delivery  Boolean                      @default(false)
  billing_issue_month_end    Boolean                      @default(false)
  customer_deposit_materials customer_deposit_materials[]
}

model deliveries {
  id                         Int                 @id @default(autoincrement())
  delivery_no                String?             @db.VarChar(50)
  customer_id                Int
  delivery_date              DateTime            @db.Date
  total_amount               Decimal?            @db.Decimal(12, 2)
  created_at                 DateTime?           @default(now()) @db.Timestamp(6)
  tax_amount                 Decimal?            @db.Decimal(12, 2)
  tax_rate                   Decimal?            @db.Decimal(5, 2)
  total_amount_including_tax Decimal?            @db.Decimal(12, 2)
  pdf_path                   String?
  pdf_filename               String?
  pdf_saved_at               DateTime?           @db.Timestamp(6)
  delivery_items             delivery_items[]
  invoice_deliveries         invoice_deliveries?
  invoice_items              invoice_items[]
}

model TaxRate {
  id             Int      @id @default(autoincrement())
  tax_rate       Decimal  @db.Decimal(5, 2)
  effective_from DateTime
  created_at     DateTime @default(now()) @db.Timestamp(6)
  updated_at     DateTime @updatedAt

  @@index([effective_from])
  @@map("tax_rates")
}

model delivery_items {
  id            Int         @id @default(autoincrement())
  delivery_id   Int
  order_item_id Int         @unique
  quantity      Int
  unit_price    Decimal     @db.Decimal(10, 2)
  amount        Decimal     @db.Decimal(12, 2)
  created_at    DateTime?   @default(now()) @db.Timestamp(6)
  deliveries    deliveries  @relation(fields: [delivery_id], references: [id])
  order_items   order_items @relation(fields: [order_item_id], references: [id])

  @@unique([delivery_id, order_item_id])
}

model invoices {
  id                     Int                  @id @default(autoincrement())
  invoice_no             String?              @db.VarChar(50)
  customer_id            Int
  closing_date           DateTime?            @db.Date
  invoice_date           DateTime?            @db.Date
  subtotal               Decimal?             @db.Decimal(12, 2)
  tax_rate               Decimal?             @db.Decimal(5, 2)
  tax_amount             Decimal?             @db.Decimal(12, 2)
  total_amount           Decimal?             @db.Decimal(12, 2)
  paid                   Boolean?             @default(false)
  created_at             DateTime?            @default(now()) @db.Timestamp(6)
  period_start           DateTime?            @db.Date
  period_end             DateTime?            @db.Date
  base_up_support_amount Decimal              @default(0) @db.Decimal(12, 2)
  display_invoice_no     String?              @db.VarChar(50)
  pdf_path               String?
  pdf_filename           String?
  pdf_saved_at           DateTime?            @db.Timestamp(6)
  issue_source           String?
  auto_issued_at         DateTime?            @db.Timestamp(6)
  auto_notice_seen_at    DateTime?            @db.Timestamp(6)
  updated_at             DateTime             @default(now()) @db.Timestamp(6)
  invoice_deliveries     invoice_deliveries[]
  invoice_items          invoice_items[]

  @@index([customer_id], map: "idx_invoices_customer_id")
  @@index([period_start, period_end], map: "idx_invoices_period")
}

model order_files {
  id         Int       @id @default(autoincrement())
  order_id   Int
  file_name  String?   @db.VarChar(255)
  file_path  String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model order_items {
  id                                     Int                                      @id @default(autoincrement())
  order_id                               Int
  insurance_item_id                      Int?
  private_item_id                        Int?
  quantity                               Int?                                     @default(1)
  unit_price                             Decimal?                                 @db.Decimal(10, 2)
  created_at                             DateTime?                                @default(now()) @db.Timestamp(6)
  work_name                              String?                                  @db.VarChar(400)
  base_up_support_target                 Boolean                                  @default(false)
  customer_deposit_material_transactions customer_deposit_material_transactions[]
  delivery_items                         delivery_items?
  invoice_items                          invoice_items[]
}

model order_teeth {
  id         Int       @id @default(autoincrement())
  order_id   Int
  tooth_no   String    @db.VarChar(10)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  is_bridge  Boolean   @default(false)
}

model orders {
  id                                     Int                                      @id @default(autoincrement())
  order_no                               String?                                  @db.VarChar(50)
  customer_id                            Int
  patient_id                             Int
  order_date                             DateTime                                 @db.Date
  delivery_date                          DateTime?                                @db.Date
  insurance_type                         String?                                  @db.VarChar(20)
  remarks                                String?
  billed                                 Boolean?                                 @default(false)
  created_at                             DateTime?                                @default(now()) @db.Timestamp(6)
  work_status                            String                                   @default("pending") @db.VarChar(20)
  customer_deposit_material_transactions customer_deposit_material_transactions[]
}

model patients {
  id           Int       @id @default(autoincrement())
  customer_id  Int
  patient_name String    @db.VarChar(100)
  patient_kana String?   @db.VarChar(100)
  gender       String?   @db.VarChar(10)
  birthday     DateTime? @db.Date
  memo         String?
  created_at   DateTime? @default(now()) @db.Timestamp(6)
}

model private_items {
  id             Int       @id @default(autoincrement())
  category       String    @db.VarChar(100)
  item_name      String    @db.VarChar(200)
  material       String?   @db.VarChar(100)
  standard_price Decimal?  @db.Decimal(10, 2)
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  sub_type       String?   @db.VarChar(200)
}

model users {
  id            Int       @id @default(autoincrement())
  login_id      String?   @unique @db.VarChar(100)
  user_name     String?   @db.VarChar(100)
  password_hash String?
  role          String?   @db.VarChar(20)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  user_sessions user_sessions[]
}

model user_sessions {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token_hash String    @unique
  expires_at DateTime  @db.Timestamp(6)
  revoked_at DateTime? @db.Timestamp(6)
  created_at DateTime  @default(now()) @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_user_sessions_user_id")
  @@index([expires_at], map: "idx_user_sessions_expires_at")
}

model materials {
  id                         Int                          @id @default(autoincrement())
  name                       String                       @db.VarChar(100)
  unit                       String                       @db.VarChar(20)
  is_active                  Boolean                      @default(true)
  created_at                 DateTime?                    @default(now()) @db.Timestamp(6)
  updated_at                 DateTime?                    @updatedAt @db.Timestamp(6)
  customer_deposit_materials customer_deposit_materials[]
  customer_materials         customer_materials[]
}

model customer_materials {
  id                    Int                     @id @default(autoincrement())
  customer_id           Int
  material_id           Int
  current_quantity      Decimal                 @default(0) @db.Decimal(10, 3)
  report_on_delivery    Boolean                 @default(false)
  is_active             Boolean                 @default(true)
  created_at            DateTime?               @default(now()) @db.Timestamp(6)
  updated_at            DateTime?               @updatedAt @db.Timestamp(6)
  materials             materials               @relation(fields: [material_id], references: [id])
  material_transactions material_transactions[]

  @@unique([customer_id, material_id])
  @@index([customer_id])
}

model material_transactions {
  id                   Int                @id @default(autoincrement())
  customer_material_id Int
  order_id             Int?
  transaction_type     String             @db.VarChar(20)
  quantity             Decimal            @db.Decimal(10, 3)
  note                 String?
  created_at           DateTime?          @default(now()) @db.Timestamp(6)
  customer_materials   customer_materials @relation(fields: [customer_material_id], references: [id])

  @@index([customer_material_id])
  @@index([order_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model customer_deposit_material_transactions {
  id                         Int                        @id @default(autoincrement())
  deposit_material_id        Int
  transaction_type           String                     @db.VarChar(20)
  quantity                   Decimal                    @db.Decimal(12, 3)
  order_id                   Int?
  order_item_id              Int?
  created_at                 DateTime                   @default(now()) @db.Timestamp(6)
  customer_deposit_materials customer_deposit_materials @relation(fields: [deposit_material_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_deposit_material_transactions_material")
  orders                     orders?                    @relation(fields: [order_id], references: [id], onUpdate: NoAction, map: "fk_deposit_material_transactions_order")
  order_items                order_items?               @relation(fields: [order_item_id], references: [id], onUpdate: NoAction, map: "fk_deposit_material_transactions_order_item")

  @@index([created_at], map: "idx_deposit_material_transactions_created_at")
  @@index([deposit_material_id], map: "idx_deposit_material_transactions_material")
  @@index([order_id], map: "idx_deposit_material_transactions_order")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model customer_deposit_materials {
  id                                     Int                                      @id @default(autoincrement())
  customer_id                            Int
  material_id                            Int
  current_quantity                       Decimal                                  @default(0) @db.Decimal(12, 3)
  created_at                             DateTime                                 @default(now()) @db.Timestamp(6)
  updated_at                             DateTime                                 @default(now()) @db.Timestamp(6)
  customer_deposit_material_transactions customer_deposit_material_transactions[]
  customers                              customers                                @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_customer_deposit_materials_customer")
  materials                              materials                                @relation(fields: [material_id], references: [id], onUpdate: NoAction, map: "fk_customer_deposit_materials_material")

  @@unique([customer_id, material_id], map: "uq_customer_deposit_materials")
  @@index([customer_id], map: "idx_customer_deposit_materials_customer")
}

model insurance_categories {
  id                       Int                        @id @default(autoincrement())
  name                     String                     @unique @db.VarChar(100)
  sort_order               Int                        @default(0)
  is_active                Boolean                    @default(true)
  created_at               DateTime?                  @default(now()) @db.Timestamp(6)
  insurance_sub_categories insurance_sub_categories[]
}

model insurance_item_masters {
  id                       Int                      @id @default(autoincrement())
  sub_category_id          Int
  name                     String                   @db.VarChar(200)
  sort_order               Int                      @default(0)
  is_active                Boolean                  @default(true)
  created_at               DateTime?                @default(now()) @db.Timestamp(6)
  insurance_sub_categories insurance_sub_categories @relation(fields: [sub_category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_insurance_item_masters_sub_category")

  @@unique([sub_category_id, name], map: "uq_insurance_item_masters")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model insurance_items_backup_20260818 {
  id         Int?
  category   String?   @db.VarChar(100)
  item_name  String?   @db.VarChar(200)
  material   String?   @db.VarChar(100)
  points     Decimal?  @db.Decimal(10, 2)
  created_at DateTime? @db.Timestamp(6)
  sub_type   String?   @db.VarChar(200)

  @@ignore
}

model insurance_sub_categories {
  id                     Int                      @id @default(autoincrement())
  category_id            Int
  name                   String                   @db.VarChar(100)
  sort_order             Int                      @default(0)
  is_active              Boolean                  @default(true)
  created_at             DateTime?                @default(now()) @db.Timestamp(6)
  insurance_item_masters insurance_item_masters[]
  insurance_categories   insurance_categories     @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_insurance_sub_categories_category")

  @@unique([category_id, name], map: "uq_insurance_sub_categories")
}

model invoice_deliveries {
  id          Int        @id @default(autoincrement())
  invoice_id  Int
  delivery_id Int        @unique(map: "uq_invoice_deliveries_delivery")
  created_at  DateTime   @default(now()) @db.Timestamp(6)
  deliveries  deliveries @relation(fields: [delivery_id], references: [id], onUpdate: NoAction, map: "fk_invoice_deliveries_delivery")
  invoices    invoices   @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_invoice_deliveries_invoice")

  @@index([invoice_id], map: "idx_invoice_deliveries_invoice_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model invoice_items {
  id                  Int          @id @default(autoincrement())
  invoice_id          Int
  delivery_id         Int
  order_item_id       Int?
  delivery_date       DateTime     @db.Date
  patient_name        String       @db.VarChar(255)
  work_name           String       @db.VarChar(500)
  tooth_display       String?      @db.VarChar(255)
  tooth_snapshot      Json?        @db.JsonB
  material_usage_text String?      @db.VarChar(255)
  quantity            Int          @default(1)
  unit_price          Decimal      @db.Decimal(12, 2)
  amount              Decimal      @db.Decimal(12, 2)
  sort_order          Int          @default(0)
  created_at          DateTime     @default(now()) @db.Timestamp(6)
  deliveries          deliveries   @relation(fields: [delivery_id], references: [id], onUpdate: NoAction, map: "fk_invoice_items_delivery")
  invoices            invoices     @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_invoice_items_invoice")
  order_items         order_items? @relation(fields: [order_item_id], references: [id], onUpdate: NoAction, map: "fk_invoice_items_order_item")

  @@index([invoice_id, delivery_date, sort_order], map: "idx_invoice_items_delivery_date")
  @@index([delivery_id], map: "idx_invoice_items_delivery_id")
  @@index([invoice_id], map: "idx_invoice_items_invoice_id")
}
